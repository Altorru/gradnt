# Strava OAuth — see supabase/README.md for the full setup.

# Client id of the GRADNT application on https://www.strava.com/settings/api
# Public by design; the matching client secret lives only in Supabase.
EXPO_PUBLIC_STRAVA_CLIENT_ID=

# The deployed strava-exchange Edge Function. This one URL does both jobs: it is
# the redirect_uri Strava returns to (GET bridges to the app scheme) and the
# token exchange endpoint (POST).
#
# e.g. https://<project-ref>.supabase.co/functions/v1/strava-exchange
EXPO_PUBLIC_STRAVA_ENDPOINT_URL=
